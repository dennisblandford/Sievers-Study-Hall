# Copy to .env for local development or a self-hosted deployment.
# Generate a secret with:
#   python -c "import secrets; print(secrets.token_hex(32))"
FLASK_SECRET_KEY=change-me
# Optional: SMTP credentials for recovery emails (the account code).
MAIL_USERNAME=
MAIL_PASSWORD=
HF_TOKEN=
PORT=8080

# Optional: override the SQLite database location
# DATABASE_URL=sqlite:///dev.db

# Set to 1 when serving over HTTPS (e.g. behind a TLS-terminating proxy)
SESSION_COOKIE_SECURE=0
